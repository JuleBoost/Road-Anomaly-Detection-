rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Require a signed-in Firebase Auth user for any allowed access.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Load the caller's profile from the users collection.
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Restrict admin access to users explicitly marked as admin.
    function isAdmin() {
      return isAuthenticated() && userProfile().data.role == "admin";
    }

    // Municipality managers include the legacy "municipality" role for backward compatibility.
    function isMunicipalityManager() {
      return isAuthenticated() && (
        userProfile().data.role == "municipality_manager"
        || userProfile().data.role == "municipality"
      );
    }

    // Municipality viewers are read-only users scoped to one municipality.
    function isMunicipalityViewer() {
      return isAuthenticated() && userProfile().data.role == "municipality_viewer";
    }

    // Match anomalies to the municipality assigned in the caller's profile.
    function sameMunicipality(resourceData) {
      return (isMunicipalityManager() || isMunicipalityViewer())
        && resourceData.municipality_id == userProfile().data.municipality_id;
    }

    // Municipality managers may update workflow status and repair evidence fields.
    function municipalityManagerAllowedUpdate() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly([
          "status",
          "updated_at",
          "repair_note",
          "repair_photo_url",
          "repair_date",
          "repaired_by",
        ]);
    }

    match /users/{uid} {
      // Users may read only their own profile document.
      allow read: if isAuthenticated() && request.auth.uid == uid;

      // Client apps cannot create, update, or delete user profiles.
      allow create, update, delete: if false;
    }

    match /anomalies/{anomalyId} {
      // Any signed-in client may create anomalies, if needed.
      allow create: if isAuthenticated();

      // Admins can read all anomalies; municipality roles can read only their own area.
      allow read: if isAdmin() || sameMunicipality(resource.data);

      // Admins can update any anomaly; municipality managers can update allowed fields in their area.
      allow update: if isAdmin()
        || (isMunicipalityManager()
          && sameMunicipality(resource.data)
          && municipalityManagerAllowedUpdate());

      // Admin should be allowed to delete anomalies if needed.
      allow delete: if isAdmin();
    }
  }
}
