rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isMunicipalityManager() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "municipality_manager";
    }

    match /repair-evidence/{anomalyId}/{filePath=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isMunicipalityManager();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
